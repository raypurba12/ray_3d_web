# Server
NODE_ENV=development
# Passenger/cPanel sets PORT automatically; locally 5000 is fine.
PORT=5000
# Comma-separated list of allowed origins (no trailing slash).
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL="mysql://root:password@localhost:3306/portfolio_cms"

# JWT secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both must be at least 32 characters and must differ from each other.
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_REFRESH_EXPIRE=30d

# File upload
MAX_FILE_SIZE=5242880
# Use an absolute path outside the app root in production (e.g. /home/<user>/portfolio-uploads)
UPLOAD_DIR=./uploads

# Cloudinary (optional). Leave all three empty for local disk storage;
# providing only some of them makes the API fail fast at boot.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin account used by `npm run prisma:seed`.
# Required in production. Password must be at least 12 characters and mix
# upper/lowercase, digits and symbols.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-with-a-strong-password
