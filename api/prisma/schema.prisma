generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Admin Users
model User {
  id             String           @id @default(cuid())
  email          String           @unique
  password       String           // bcrypt hashed
  name           String
  role           Role             @default(ADMIN)
  tokenVersion   Int              @default(0)
  refreshSessions RefreshSession[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("users")
}

// Rotating refresh-token sessions (one row per issued refresh token)
model RefreshSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// Projects/Portfolio Items
model Project {
  id           String         @id @default(cuid())
  title        String
  description  String         @db.Text
  image        String
  metric       String?
  tags         Tag[]          @relation("ProjectTags")
  technologies Technology[]   @relation("ProjectTechnologies")
  images       ProjectImage[]
  demoUrl      String?
  githubUrl    String?
  featured     Boolean        @default(false)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([featured, order])
  @@map("projects")
}

// Additional screenshots per project
model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  image     String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

// Technologies/Skills
model Technology {
  id          String       @id @default(cuid())
  name        String       @unique
  icon        String
  category    TechCategory
  projects    Project[]    @relation("ProjectTechnologies")
  experiences Experience[] @relation("ExperienceTechnologies")
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([order])
  @@map("technologies")
}

enum TechCategory {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  DESIGN
  OTHER
}

// Work Experience
model Experience {
  id           String       @id @default(cuid())
  title        String
  company      String
  companyLogo  String?
  location     String?
  startDate    DateTime
  endDate      DateTime?
  description  String       @db.Text
  technologies Technology[] @relation("ExperienceTechnologies")
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([order])
  @@map("experiences")
}

// Client Testimonials
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  avatar    String?
  content   String   @db.Text
  rating    Int      @default(5)
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([featured, order])
  @@map("testimonials")
}

// Tags for categorization
model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String?   // hex color
  projects  Project[] @relation("ProjectTags")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tags")
}

// Anonymous site analytics
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  visitorId String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([createdAt, visitorId])
  @@map("page_views")
}

model CvDownload {
  id        String   @id @default(cuid())
  visitorId String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("cv_downloads")
}

// Portfolio photo gallery
model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  image     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("gallery_images")
}

// Contact messages from the public site
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

// Profile Info (single record)
model Profile {
  id        String   @id @default("profile")
  name      String
  tagline   String
  bio       String   @db.Text
  avatar    String
  resumeUrl String?
  email     String
  phone     String?
  location  String?
  github    String?
  linkedin  String?
  twitter   String?
  website   String?
  updatedAt DateTime @updatedAt

  @@map("profile")
}
