# Base URL of the CMS API (default: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Public site URL used for canonical links, sitemap and Open Graph tags
# (default: current browser origin)
VITE_SITE_URL=https://raypurba.my.id

# Optional public contact email shown when the CMS profile has none.
# Leave empty to hide email links.
VITE_CONTACT_EMAIL=
